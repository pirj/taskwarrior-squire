#!/usr/bin/env python3
"""Hygiene and flow rules for every added or changed task.

taskwarrior runs this file as on-add (one task on stdin) and on-modify
(the old task, then the new one). It prints the task to store, or a
refusal and a non-zero exit.
"""
import json
import os
import sys

TITLE_MAX = 80
BODY_MAX = 800
COMMENT_MAX = 500
STATE_OF_STATUS = {"completed": "done", "deleted": "rejected"}
STATUS_OF_STATE = {state: status for status, state in STATE_OF_STATUS.items()}
# The moves an assistant may make. The human moves a task anywhere.
ASSISTANT_MOVES = {
    "idea": set(),
    "open": {"doing", "postponed", "rejected"},
    "doing": {"fixed", "open", "postponed", "rejected"},
    "fixed": {"done", "open", "postponed", "rejected"},
    "done": {"open"},
    "postponed": {"open", "rejected"},
    "rejected": set(),
}
FLOW = "open → doing → fixed → done"
DONE_WHEN = "DONE WHEN:"

actor = os.environ.get("SQUIRE_AUTHOR") or os.environ["USER"]
human = actor == os.environ["USER"]


def refuse(message):
    print(message)
    sys.exit(1)


def check_length(field, text, limit):
    if len(text) > limit:
        refuse(f"{field} is {len(text)} > {limit} characters; "
               "shorten it")


lines = sys.stdin.read().splitlines()
old = json.loads(lines[0]) if len(lines) == 2 else {}
new = json.loads(lines[-1])

if new.get("status") != old.get("status") and new.get("status") in STATE_OF_STATUS:
    new["state"] = STATE_OF_STATUS[new["status"]]
elif new.get("state") != old.get("state"):
    new["status"] = STATUS_OF_STATE.get(new.get("state"), "pending")

for field, limit in (("description", TITLE_MAX), ("body", BODY_MAX)):
    if new.get(field, "") != old.get(field, ""):
        check_length(field, new.get(field, ""), limit)

for tag in set(new.get("tags", [])) - set(old.get("tags", [])):
    if not tag[0].isalpha():
        refuse(f"tag {tag} does not start with a letter, and taskwarrior reads +{tag} and -{tag} "
               f"as text; put a number in a field, such as version:{tag}")

known = {(a["entry"], a["description"]) for a in old.get("annotations", [])}
for annotation in new.get("annotations", []):
    if (annotation["entry"], annotation["description"]) in known:
        continue
    check_length("comment", annotation["description"], COMMENT_MAX)
    annotation["description"] = f"[{actor}] {annotation['description']}"

state, was = new.get("state", "idea"), old.get("state", "idea")
if not human and not old and state != "idea" and not ("bug" in new.get("tags", []) and state == "open"):
    refuse(f"{actor} may add an idea, or a +bug as open; the human approves the rest")
if not human and old and state != was and state not in ASSISTANT_MOVES[was]:
    if was == "idea":
        refuse(f"only the human decides on an idea; {actor} may not move it to {state}")
    refuse(f"{actor} may not move a task from {was} to {state}; the flow is {FLOW}")
texts = [new.get("body", "")] + [a["description"] for a in new.get("annotations", [])]
if state in ("open", "doing") and state != was and not any(DONE_WHEN in text.upper() for text in texts):
    refuse(f"a task needs its definition of done before it is {state}: "
           f"add '{DONE_WHEN} <what shows it is done>' to its body or a comment")

if not old:
    new["author"] = actor
elif new != old:
    new["changed_by"] = actor

print(json.dumps(new, ensure_ascii=False))
