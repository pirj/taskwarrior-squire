#!/bin/sh
# squire: taskwarrior with the project's task database, flow and hygiene rules.
set -e

home=$(dirname "$(readlink -f "$0")")
export SQUIRE_HOME="$home" SQUIRE_AUTHOR="${SQUIRE_AUTHOR:-$USER}"

case "$1" in
  -h|--help|help)
    cat <<USAGE
usage: squire                    the live tasks assigned to you, most urgent first
       squire init               create .squire/ in the current directory
       squire <taskwarrior arguments>

The database is the nearest .squire/ in this directory or above it.
Author of every change: \$SQUIRE_AUTHOR, else \$USER (now: $SQUIRE_AUTHOR).
Everything else is taskwarrior: see 'task help'.
USAGE
    exit 0 ;;
  init)
    mkdir .squire
    echo "created $PWD/.squire"
    exit 0 ;;
esac

dir=$PWD
until [ -d "$dir/.squire" ]; do
  if [ "$dir" = / ]; then
    echo "squire: no .squire/ here or above; run 'squire init' in the project root" >&2
    exit 1
  fi
  dir=$(dirname "$dir")
done

export TASKRC="$home/squire.rc" TASKDATA="$dir/.squire"
[ $# -gt 0 ] || set -- inbox
exec task "$@"
