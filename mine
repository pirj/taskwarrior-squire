#!/usr/bin/env python3
"""task mine: the live tasks assigned to $SQUIRE_AUTHOR (else $USER): tasks with no
version first, then by version, the most urgent first within each.

A section shows the state, priority, version, ref and tags of the task, and what
the assignee is asked: the newest comment by someone else, else the body.
Arguments narrow the filter.
"""
import json
import os
import re
import subprocess
import sys

actor = os.environ.get("SQUIRE_AUTHOR") or os.environ["USER"]
tasks = json.loads(subprocess.run(
    ["task", "+READY", "state.not:postponed", f"assignee:{actor}", *sys.argv[1:], "export"],
    check=True, capture_output=True, text=True).stdout)


def author_of(annotation):
    match = re.match(r"\[([^\]]+)\] ", annotation["description"])
    return match and match.group(1)


def version(t):
    return tuple(int(part) if part.isdigit() else 0 for part in re.split(r"[.-]", t.get("version", "")) if part)


for t in sorted(tasks, key=lambda t: (version(t), -t["urgency"])):
    request = next((a["description"] for a in reversed(t.get("annotations", []))
                    if author_of(a) != actor), t.get("body"))
    print(f"## {t['uuid'][:8]} — {t['description']}\n")
    tags = " ".join(f"+{tag}" for tag in t.get("tags", []))
    print(" · ".join(filter(None, (t.get("state"), t.get("priority"), t.get("version"), t.get("ref"), tags))))
    if request:
        print(f"\n{request}")
    print()
