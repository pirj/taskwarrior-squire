#!/usr/bin/env python3
"""squire init: point the project in the current directory at taskwarrior-squire.
squire tui: open taskwarrior-tui on the tasks that wait for you.

It prints TASKRC and TASKDATA for you to set in this directory, with whatever
sets your per-directory environment. When .claude/ exists, it writes them for
Claude Code too: the env in .claude/settings.json, a hook that puts the
installed SKILL.md into every session and subagent, and in .claude/skills/ a
skill that reads it, so both follow upgrades. taskwarrior
creates the database on first use. Everything after that is `task`: man taskwarrior-squire.
"""
import collections
import json
import os
import re
import subprocess
import sys
import tempfile

SHARE = "@SHARE@"
TASKRC = f"{SHARE}/taskrc"
STUB = """The instructions come with the installed taskwarrior-squire, so they match
its version. Read them before your first `task` command:

    cat "$(dirname "$TASKRC")/SKILL.md"
"""
HOOK = ("python3 -c 'import json, sys; event = json.load(sys.stdin)[\"hook_event_name\"]; "
        f"text = open(\"{SHARE}/SKILL.md\").read().split(\"---\\n\", 2)[2]; "
        "print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": event, \"additionalContext\": text}}))'")
project = os.getcwd()

if sys.argv[1:] == ["tui"]:
    with tempfile.NamedTemporaryFile("w", suffix=".taskrc") as rc:
        rc.write(f"include {os.environ.get('TASKRC', TASKRC)}\ninclude {SHARE}/tui/taskrc\n"
                 f"report.inbox.filter=+READY state.not:postponed assignee:{os.environ['USER']}\n")
        rc.flush()
        try:
            sys.exit(subprocess.run(["taskwarrior-tui", "--report", "inbox"], env=dict(os.environ, TASKRC=rc.name)).returncode)
        except FileNotFoundError:
            sys.exit("squire tui needs taskwarrior-tui: brew install taskwarrior-tui")
if sys.argv[1:] != ["init"]:
    sys.exit(__doc__.strip() + "\n\nusage: squire init | squire tui")


def say(text):
    print(f"squire: {text}")


home_rc = os.path.expanduser("~/.taskrc")
if not os.path.exists(home_rc):
    open(home_rc, "a").close()
    say(f"created an empty {home_rc}; the squire taskrc includes it")

say("set these in this directory's environment (mise, direnv, an .env loader…):")
print(f"  TASKRC={TASKRC}\n  TASKDATA={project}")

# board sorts by version_order, which the hook writes; give it to the tasks the hook has not seen.
task = ["task", "rc.hooks=off", "rc.bulk=0"]
env = dict(os.environ, TASKRC=TASKRC, TASKDATA=project)
if os.path.exists("taskchampion.sqlite3"):
    unseen = collections.defaultdict(list)
    for t in json.loads(subprocess.run(task + ["export"], env=env, check=True, capture_output=True, text=True).stdout):
        if "version_order" not in t:
            order = ".".join(p.zfill(6) if p.isdigit() else "000000" for p in re.split(r"[.-]", t.get("version", "")) if p) or "0"
            unseen[order].append(t["uuid"])
    for order, uuids in unseen.items():
        done = subprocess.run(task + uuids + ["modify", f"version_order:{order}"], env=env,
                              stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if done.returncode:
            sys.exit(f"squire: task modify version_order:{order} failed: {done.stdout}{done.stderr}")
    if unseen:
        say(f"gave {sum(map(len, unseen.values()))} task(s) the version order that task board sorts by")

if os.path.isdir(".claude"):
    path = ".claude/settings.json"
    settings = json.load(open(path)) if os.path.exists(path) else {}
    env = settings.setdefault("env", {})
    env.setdefault("SQUIRE_AUTHOR", "claude")
    env.update(TASKRC=TASKRC, TASKDATA=project)
    hooks = settings.setdefault("hooks", {})
    for event in ("SessionStart", "SubagentStart"):
        groups = [g for g in hooks.get(event, []) if HOOK not in (h.get("command") for h in g["hooks"])]
        hooks[event] = groups + [{"hooks": [{"type": "command", "command": HOOK}]}]
    with open(path, "w") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    os.makedirs(".claude/skills/taskwarrior-squire", exist_ok=True)
    frontmatter = open(f"{SHARE}/SKILL.md").read().split("---\n")[1]
    with open(".claude/skills/taskwarrior-squire/SKILL.md", "w") as f:
        f.write(f"---\n{frontmatter}---\n\n{STUB}")
    say(f"Claude Code: env and hooks in {path} (SQUIRE_AUTHOR={env['SQUIRE_AUTHOR']}), "
        "skill in .claude/skills/taskwarrior-squire/")
else:
    say("another assistant: give it TASKRC, TASKDATA and SQUIRE_AUTHOR=<its name>, "
        f"and point it at {SHARE}/SKILL.md")
