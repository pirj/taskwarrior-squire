# taskwarrior-squire: set TASKRC to this file. See taskwarrior-squire(7).
# Your own settings come first; the lines below override only what squire needs.
include ~/.taskrc
verbose=nothing
confirmation=off
hooks.location=@SHARE@/hooks
alias.mine=execute @SHARE@/mine

report.board.description=Live tasks, one line each
report.board.columns=uuid.short,state,assignee,priority,version,ref,tags,description.truncated_count
report.board.labels=UUID,State,Assignee,P,Version,Ref,Tags,Title
report.board.filter=status:pending
report.board.sort=urgency-

uda.state.type=string
uda.state.label=State
uda.state.values=idea,open,doing,fixed,done,postponed,rejected
uda.state.default=idea

uda.assignee.type=string
uda.assignee.label=Assignee

uda.version.type=string
uda.version.label=Version

uda.body.type=string
uda.body.label=Body

uda.author.type=string
uda.author.label=Author

uda.changed_by.type=string
uda.changed_by.label=Changed by

uda.ref.type=string
uda.ref.label=Ref
